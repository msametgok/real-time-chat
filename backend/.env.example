# Copy to .env for local work. On a host (Render etc.) set these as environment
# variables instead - never upload the file.

# Render supplies PORT itself and expects the server to bind whatever it sets.
# server.js already falls back to 5000, so leave this unset in production.
PORT=5000

NODE_ENV=development

# Atlas: mongodb+srv://<user>:<pass>@<cluster>/<dbname>?retryWrites=true&w=majority
# The password must be URL-encoded - a literal @ or # in it silently breaks the
# connection string. Give the deploy its own DB user, not your admin account.
MONGO_URI=mongodb://127.0.0.1:27017/real-time-chat

# Generate fresh for production, never reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me
JWT_EXPIRES=7d

# EXACTLY 32 characters. utils/encryption.js does Buffer.from(ENCRYPTION_KEY)
# with the default utf8 encoding, so this is measured in characters, not hex
# bytes - a 64-char hex string is 64 bytes and throws on the first encrypt.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64').slice(0,32))"
#
# Changing this on an existing database makes every stored message undecryptable
# ([Message unavailable] in the UI). It is not rotatable without re-encrypting.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Redis is required, not optional: config/socket.js opens pub/sub clients for
# the Socket.IO adapter at boot, and presence + the chat cache live here too.
# The provider must support real pub/sub.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# true for any hosted provider (Redis Cloud, Upstash); leave empty locally.
REDIS_TLS=

# The frontend's exact origin: scheme included, NO trailing slash.
# Used by both the Express CORS config and the Socket.IO handshake - get it
# wrong and the app still loads and logs in, but realtime silently never
# connects. That is the single most common deploy mistake here.
CLIENT_URL=http://localhost:5173

# Demo mode: seeds the demo companions and runs their bot clients. Leave unset
# or false anywhere that is not the public demo deployment.
DEMO_MODE=false
