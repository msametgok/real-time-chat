# Copy to .env.local for local work. On Vercel set these in Project Settings ->
# Environment Variables.
#
# These are read through import.meta.env and are baked into the bundle at BUILD
# time (services/api.js, services/socket.js). Changing them on the host does
# nothing until you redeploy - a rebuild is required, not a restart.
#
# Both point at the backend origin: scheme included, no trailing slash.
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Shows the "Try the live demo" button on the login page. Set it only on the
# public demo deployment, and only where the backend also has DEMO_MODE=true -
# with one set and not the other the button appears and 404s.
VITE_DEMO_MODE=false
